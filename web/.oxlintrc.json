{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "dist",
    "playwright-report",
    "test-results"
  ],
  "overrides": [
    {
      "files": [
        "src/features/auth/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/overview/**",
                  "@/features/accounts/**",
                  "@/features/real-estate/**",
                  "@/features/goals/**",
                  "@/features/projection/**",
                  "@/features/fees/**",
                  "@/features/connections/**",
                  "@/features/settings/**"
                ],
                "message": "Une feature n'importe jamais une autre feature : ce qui est partagé va dans shared/."
              },
              {
                "group": [
                  "@/app/**"
                ],
                "message": "Une feature ne dépend pas de app/."
              },
              {
                "group": [
                  "../../*",
                  "../../**"
                ],
                "message": "Hors de la feature, importez via l'alias @/shared/…"
              }
            ]
          }
        ]
      }
    },
    {
